# Copie ce fichier en ".env" (dans le même dossier) et remplis les valeurs.
# Ne partage jamais ce fichier une fois rempli et ne le commite pas dans Git.

# Quel fournisseur IA utiliser : "gemini" (gratuit, par défaut) ou "anthropic"
# (payant à l'usage). Laisse vide ou absent pour "gemini".
FOURNISSEUR_IA=gemini

# --- Gemini (gratuit) ---
# Clé à récupérer sur https://aistudio.google.com/apikey (aucune carte
# bancaire requise). Indépendant d'un éventuel abonnement Gemini Advanced.
GEMINI_API_KEY=

# Optionnel : modèle Gemini à utiliser (laisser vide/absent pour la valeur
# par défaut, gemini-3.5-flash-lite — quota gratuit bien plus généreux que
# les modèles "Flash" normaux, largement suffisant pour cette app). Si tu
# avais ajouté "GEMINI_MODEL=gemini-2.5-flash" suite à une suggestion
# précédente : supprime cette ligne ou remplace-la, ce modèle n'est plus
# disponible (retiré par Google, "no longer available to new users").
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (payant, seulement si FOURNISSEUR_IA=anthropic) ---
# Clé à récupérer sur https://console.anthropic.com (Settings > API Keys).
# ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : modèle Claude à utiliser (laisser vide pour la valeur par défaut).
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Export PDF sans Word ni LibreOffice (optionnel) ---
# Si aucun des deux n'est installé sur ta machine, l'app peut utiliser
# iLovePDF (gratuit, 250 conversions/mois, aucune carte requise) : crée un
# compte sur https://developer.ilovepdf.com puis colle tes clés ci-dessous.
# ATTENTION : le contenu de ton CV/lettre est alors envoyé à leurs serveurs.
# ILOVEPDF_PUBLIC_KEY=
# ILOVEPDF_SECRET_KEY=

# Optionnel : si LibreOffice est installé mais que sa configuration est
# cassée sur ta machine (ex: message "bootstrap.ini est défectueux" qui
# revient même après réinstallation), mets DESACTIVER_LIBREOFFICE=1 pour que
# l'app ne tente plus jamais de le lancer et passe direct à Word ou iLovePDF.
# DESACTIVER_LIBREOFFICE=1
